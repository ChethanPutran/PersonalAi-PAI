{
  "id": "plugin-clipboard",
  "name": "Clipboard Plugin",
  "version": "1.0.0",
  "plugin_type": "action",
  "entry_point": "clipboard_plugin.py",
  "description": "Clipboard read/write operations",
  "permissions": [
    "clipboard"
  ],
  "dependencies": [
    "pyperclip"
  ],
  "config_schema": {
    "auto_sync": {
      "type": "boolean",
      "description": "Sync clipboard automatically",
      "default": false
    }
  }
}
