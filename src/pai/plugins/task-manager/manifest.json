{
  "id": "task_manager",
  "name": "Task Manager Plugin",
  "version": "1.0.0",
  "type": "action",
  "description": "Create, update and track tasks",

  "runtime": {
    "entry_point": "task_manager_plugin.py",
    "class": "TaskManagerPlugin"
  },

  "permissions": [
    "file_read",
    "file_write"
  ],

  "dependencies": [],

  "capabilities": [
    {
      "name": "task_manager.add_task",
      "description": "Create a new task",
      "risk": "low",
      "parameters": {
        "title": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "name": "task_manager.list_tasks",
      "description": "List tasks",
      "risk": "low",
      "parameters": {
        "status": {
          "type": "string",
          "required": false,
          "default": "all"
        }
      }
    },
    {
      "name": "task_manager.complete_task",
      "description": "Mark a task as completed",
      "risk": "low",
      "parameters": {
        "task_id": {
          "type": "integer",
          "required": true
        }
      }
    },
    {
      "name": "task_manager.delete_task",
      "description": "Delete a task",
      "risk": "medium",
      "parameters": {
        "task_id": {
          "type": "integer",
          "required": true
        }
      }
    }
  ],

  "config_schema": {
    "default_status": {
      "type": "string",
      "description": "Default task status",
      "default": "pending"
    },
    "tasks_file": {
      "type": "string",
      "description": "Path to the local task store",
      "default": "./data/tasks.json"
    }
  }
}