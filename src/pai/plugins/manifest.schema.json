{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pai.dev/schemas/plugin-manifest.json",
  "title": "PAI Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "name", "version",
    "author", "license", "type", "runtime", "capabilities"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 2 },
    "id":            { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9._-]*$" },
    "name":          { "type": "string", "minLength": 1 },
    "version":       { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description":   { "type": "string" },
    "changelog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary":  { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "fixes":    { "type": "array", "items": { "type": "string" } },
        "breaking": { "type": "array", "items": { "type": "string" } }
      }
    },
    "author":        { "type": "string", "minLength": 1 },
    "license":       { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["native", "kotlin", "swift", "python", "javascript"]
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "platforms": {
      "type": "object",
      "propertyNames": { "enum": ["android", "ios", "linux", "macos", "windows"] },
      "additionalProperties": { "$ref": "#/$defs/platformSpec" }
    },
    "architectures": { "type": "array", "items": { "enum": ["arm64", "x86_64", "x86"] } },
    "deviceTypes":   { "type": "array", "items": { "enum": ["phone", "tablet", "laptop", "desktop", "server", "unknown"] } },
    "permissions":   { "type": "array", "items": { "$ref": "#/$defs/permissionResource" } },
    "dependencies":  { "type": "array", "items": { "type": "string" } },
    "postInstall": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "metadata":     { "type": "object" },
    "configSchema": { "type": "object" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "allOf": [
    {
      "if":   { "properties": { "runtime": { "properties": { "kind": { "const": "server" } } } } },
      "then": { "properties": { "deviceTypes": { "contains": { "const": "server" } } } }
    },
    {
      "if":   { "properties": { "runtime": { "properties": { "kind": { "const": "device" } } } } },
      "then": { "properties": { "deviceTypes": { "not": { "contains": { "const": "server" } } } } }
    }
  ],
  "$defs": {
    "permissionResource": {
      "enum": ["camera", "microphone", "speaker", "filesystem", "network", "shell", "notifications", "location", "contacts",
               "calendar", "screen", "clipboard", "input", "device", "process", "system", "storage", "memory", "personal_data"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nativeModule"],
      "properties": {
        "kind":          { "type": "string", "enum": ["server", "device"] },
        "nativeModule":  { "type": "string", "minLength": 1 },
        "minPaiVersion": { "type": "string" },
        "minAppVersion": { "type": "string" }
      }
    },
    "platformSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "entrypoint"],
      "properties": {
        "artifact":   { "type": "string" },
        "entrypoint": { "type": "string" }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "field"],
      "properties": {
        "type":               { "type": "string", "enum": ["pathInRoots", "commandPrefix", "envPresent", "consentFlag"] },
        "field":              { "type": "string", "minLength": 1 },
        "allowedRootsRef":    { "type": "string" },
        "allowedPrefixesRef": { "type": "string" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id":                  { "type": "string", "minLength": 1 },
        "description":         { "type": "string" },
        "risk":                { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "requireConfirmation": { "type": "boolean" },
        "retryable":           { "type": "boolean" },
        "controls":            { "$ref": "#/$defs/controls" },
        "taskType":            { "type": "string", "enum": ["one_shot", "long_running", "stream"] },
        "timeoutSeconds":      { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "maxGrantScope":       { "type": "string", "enum": ["once", "session", "always"] },
        "confirmationReason":  { "type": "string" },
        "confirmationPreview": { "type": "object" },
        "precondition":        { "$ref": "#/$defs/precondition" },
        "permissions":         { "type": "array", "items": { "type": "string" } },
        "parameters":          { "$ref": "#/$defs/parametersSchema" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pause":  { "type": "boolean" },
        "cancel": { "type": "string", "enum": ["cooperative", "best_effort", "none"] }
      }
    },
    "parametersSchema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type":       { "const": "object" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type":        { "type": "string", "enum": ["string", "number", "integer", "boolean", "array", "object", "null"] },
        "description": { "type": "string" },
        "default":     {},
        "enum":        { "type": "array" },
        "pattern":     { "type": "string" },
        "minimum":     { "type": "number" },
        "maximum":     { "type": "number" },
        "minLength":   { "type": "integer", "minimum": 0 },
        "maxLength":   { "type": "integer", "minimum": 0 },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "required": { "type": "array", "items": { "type": "string" } },
        "items":    { "$ref": "#/$defs/parameter" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "array" } }, "required": ["type"] },
          "then": { "required": ["items"] } },
        { "if": { "properties": { "type": { "not": { "const": "object" } } }, "required": ["type"] },
          "then": { "properties": { "required": { "maxItems": 0 } } } }
      ]
    }
  }
}