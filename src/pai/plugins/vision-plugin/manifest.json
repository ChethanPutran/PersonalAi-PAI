{
  "id": "plugin-vision",
  "name": "Vision Plugin",
  "version": "1.0.0",
  "plugin_type": "intelligence",
  "entry_point": "main.py",
  "description": "Camera and image understanding using computer vision",
  "permissions": ["camera", "file_read"],
  "dependencies": ["opencv-python", "numpy"],
  "config_schema": {
    "model": {
      "type": "string",
      "description": "Vision model to use",
      "default": "yolo-v8"
    },
    "confidence_threshold": {
      "type": "number",
      "description": "Detection confidence threshold",
      "default": 0.5
    }
  }
}
