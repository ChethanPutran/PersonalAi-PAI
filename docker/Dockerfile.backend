# PAI backend (FastAPI API). Build from the repo root:
#   docker build -f docker/Dockerfile.backend -t pai-backend .
#
# Run (secrets come from the environment, never from the image):
#   docker run -d -p 8000:8000 \
#     -e SECURITY__JWT_SECRET=...   -e SECURITY__ENCRYPTION_KEY=... \
#     -e LLM_PROVIDER__API_KEY=...  \
#     -v pai-data:/app/data -v pai-logs:/app/logs  pai-backend
# or --env-file .env. SECURITY__JWT_SECRET and SECURITY__ENCRYPTION_KEY are required (the app refuses to
# start without them). First start takes about a minute. If the build cannot reach PyPI (some networks
# block the DNS servers Docker uses) add: --add-host pypi.org:<ip> --add-host files.pythonhosted.org:<ip>
# or point Docker's daemon at your network's resolver.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app

# Dependencies first: this layer (6+ GB of wheels) is cached until the lock or a pyproject changes, so it
# must not depend on anything else (the READMEs are only needed to build the project itself, below).
# `pai-device` is a workspace member the backend depends on, so its pyproject must be present.
COPY pyproject.toml uv.lock ./
COPY device/pyproject.toml ./device/
RUN uv sync --frozen --no-dev --no-install-project --no-install-workspace

COPY README.md ./
COPY device/README.md ./device/
COPY src/ ./src/
COPY device/src/ ./device/src/
RUN uv sync --frozen --no-dev


FROM python:3.12-slim
RUN useradd --create-home --uid 1000 pai
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
# The project and the pai-device workspace member are installed editable (pointing at these paths), so
# the sources must be in the final image too.
COPY --chown=pai:pai src/ ./src/
COPY --chown=pai:pai device/src/ ./device/src/
COPY --chown=pai:pai config/ ./config/
COPY --chown=pai:pai prompts/ ./prompts/
COPY --chown=pai:pai plugin_registry/ ./plugin_registry/
RUN mkdir -p data logs && chown pai:pai data logs

ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER pai
EXPOSE 8000
VOLUME ["/app/data", "/app/logs"]
# Secrets (LLM keys, JWT secret, DB url) come from the environment / an --env-file, never the image.
CMD ["pai"]
