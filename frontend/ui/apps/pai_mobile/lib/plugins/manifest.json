{
  "schemaVersion": 1,
  "id": "camera",
  "name": "Camera",
  "version": "1.0.0",
  "description": "Capture photos and record video.",
  "author": "PAI Labs",
  "homepage": "https://pai.example/plugins/camera",
  "icon": "icon.png",
  "license": "MIT",

  "runtime": {
    "kind": "native",
    "nativeModule": "pai.camera",
    "minPaiVersion": "0.4.0"
  },

  "platforms": {
    "android": {
      "artifact": "native/android/pai-camera-android.aar",
      "entrypoint": "com.pai.plugins.camera.CameraModule"
    },
    "linux": {
      "artifact": "native/linux/libpai_camera.so",
      "entrypoint": "pai_camera_module_create"
    },
    "windows": {
      "artifact": "native/windows/pai_camera.dll",
      "entrypoint": "pai_camera_module_create"
    },
    "macos": {
      "artifact": "native/macos/PaiCamera.framework",
      "entrypoint": "pai_camera_module_create"
    }
  },

  "permissions": ["camera", "microphone", "filesystem"],

  "capabilities": [
    {
      "id": "camera.capture",
      "description": "Take a still photo.",
      "permissions": ["camera", "filesystem"],
      "parameters": { "type": "object", "properties": { "...": {} } }
    },
    {
      "id": "camera.record",
      "description": "Record a video.",
      "permissions": ["camera", "microphone", "filesystem"],
      "parameters": { "type": "object", "properties": { "...": {} } }
    }
  ],

  "integrity": {
    "sha256": "…",
    "signature": "…",
    "signerKeyId": "pai-labs-2025"
  }
}