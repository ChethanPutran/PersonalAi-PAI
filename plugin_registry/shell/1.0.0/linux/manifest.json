{
  "schemaVersion": 1,
  "id": "shell",
  "name": "Shell",
  "version": "1.0.0",
  "description": "Execute whitelisted shell commands on the host.",
  "author": "PAI",
  "license": "MIT",

  "runtime": {
    "kind": "native",
    "nativeModule": "pai.shell",
    "minPaiVersion": "0.4.0"
  },

  "platforms": {
    "linux": {
      "artifact": "linux/libpai_shell.so",
      "entrypoint": "pai_plugin_module_create"
    }
  },

  "architectures": ["x86_64"],

  "device_types": ["desktop"],

  "permissions": ["process"],

  "metadata": {
    "requires_confirmation": true,
    "allowed_prefixes": [
      "ls", "pwd", "whoami", "date", "uptime", "hostname", "uname",
      "df", "du", "free", "ps", "top", "htop", "iostat", "vmstat",
      "cat", "head", "tail", "wc", "grep", "find", "stat", "file",
      "git status", "git log", "git diff", "git branch", "git show",
      "systemctl status", "systemctl list-units",
      "docker ps", "docker images", "docker logs",
      "echo"
    ]
  },

  "capabilities": [
    {
      "id": "shell.exec",
      "description": "Execute a whitelisted shell command on the host. Shell metacharacters (; & | > < $ `) are rejected. Configure PAI_SHELL_WHITELIST env to add prefixes.",
      "permissions": ["process"],
      "parameters": {
        "type": "object",
        "properties": {
          "command": {"type": "string", "description": "The command to run, e.g. 'ls -la /tmp'"},
          "timeout_sec": {"type": "integer", "default": 30, "description": "Hard timeout in seconds (1-300)"}
        },
        "required": ["command"]
      }
    }
  ]
}