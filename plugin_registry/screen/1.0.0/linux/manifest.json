{
  "schemaVersion": 1,
  "id": "screen",
  "name": "Screen",
  "version": "1.0.0",
  "description": "Capture screenshots of the host screen.",
  "author": "PAI",
  "license": "MIT",

  "runtime": {
    "kind": "native",
    "nativeModule": "pai.screen",
    "minPaiVersion": "0.4.0"
  },

  "platforms": {
    "linux": {
      "artifact": "linux/libpai_screen.so",
      "entrypoint": "pai_plugin_module_create"
    }
  },

  "architectures": ["x86_64"],
  "device_types": ["desktop"],
  "permissions": ["screen"],

  "metadata": {
    "requires_confirmation": true,
    "requires_consent_env": "PAI_SCREEN_CONSENT"
  },

  "capabilities": [
    {
      "id": "screen.capture",
      "description": "Take a screenshot. Uses grim (Wayland) or scrot/import (X11). Requires PAI_SCREEN_CONSENT=1 in the agent env.",
      "permissions": ["screen"],
      "parameters": {
        "type": "object",
        "properties": {
          "outputPath": {"type": "string", "description": "Absolute path for the PNG. Defaults to ~/Pictures/PAI/screen_<timestamp>.png"}
        }
      }
    }
  ]
}