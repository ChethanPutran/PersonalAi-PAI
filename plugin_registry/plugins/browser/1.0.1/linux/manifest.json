{
  "schemaVersion": 2,
  "id": "browser_linux",
  "name": "Browser",
  "version": "1.0.1",
  "type": "python",
  "author": "PAI",
  "license": "MIT",
  "description": "Browse web, fill forms, automate bookings.",
  "runtime": {
    "kind": "server",
    "nativeModule": "pai.browser.server"
  },
  "platforms": {
    "linux": {
      "artifact": "linux/browser_plugin.py",
      "entrypoint": "create_plugin"
    }
  },
  "architectures": ["x86_64"],
  "dependencies": ["playwright>=1.48,<2.0", "httpx>=0.27,<1.0"],
  "postInstall": [
    ["python", "-m", "playwright", "install", "chromium", "--with-deps"]
  ],
  "deviceTypes": ["server"],
  "capabilities": [
    {
      "id": "browser.navigate",
      "taskType": "one_shot",
      "timeoutSeconds": 60,
      "description": "Open a URL and return the rendered text/title.",
      "requireConfirmation": true,
      "confirmationReason": "Navigating to arbitrary URLs can be dangerous. Please confirm that you want to open this URL.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "waitUntil": {
            "type": "string",
            "enum": ["load", "domcontentloaded", "networkidle"],
            "default": "domcontentloaded"
          }
        },
        "required": ["url"]
      }
    },
    {
      "id": "browser.fillForm",
      "taskType": "one_shot",
      "timeoutSeconds": 90,
      "description": "Fill fields and optionally submit a form.",
      "requireConfirmation": true,
      "confirmationReason": "Filling forms can be dangerous. Please confirm that you want to fill this form.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "submitSelector": {
            "type": "string"
          },
          "screenshot": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["url", "fields"]
      }
    },
    {
      "id": "browser.book",
      "taskType": "one_shot",
      "timeoutSeconds": 300,
      "description": "High-level booking flow: navigate, fill, submit, capture confirmation.",
      "requireConfirmation": true,
      "confirmationReason": "Booking services can be risky. Please confirm that you want to proceed with this booking.",
      "parameters": {
        "type": "object",
        "properties": {
          "startUrl": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": ["navigate", "fill", "click", "wait", "screenshot"]
                },
                "selector": { "type": "string" },
                "value": { "type": "string" },
                "url": { "type": "string" },
                "ms": { "type": "integer", "default": 500 }
              },
              "required": ["action"]
            }
          }
        },
        "required": ["startUrl", "steps"]
      }
    }
  ]
}
