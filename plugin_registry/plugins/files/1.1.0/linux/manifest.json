{
  "schemaVersion": 1,
  "id": "files",
  "name": "Files",
  "type": "native",
  "version": "1.1.0",
  "description": "Read, write, and manage files within allowed roots.",
  "author": "PAI",
  "license": "MIT",
  "runtime": {
    "kind": "device",
    "nativeModule": "pai.files",
    "minPaiVersion": "0.4.0"
  },
  "platforms": {
    "linux": {
      "artifact": "linux/libpai_files.so",
      "entrypoint": "pai_plugin_module_create"
    }
  },
  "architectures": [
    "x86_64"
  ],
  "deviceTypes": [
    "desktop"
  ],
  "permissions": [
    "filesystem"
  ],
  "metadata": {
    "allowedRoots": [
      "~/Documents",
      "~/Downloads",
      "~/Pictures",
      "~/Videos",
      "~/Desktop",
      "/tmp/pai",
      "/data/pai"
    ]
  },
  "capabilities": [
    {
      "id": "files.list",
      "taskType": "one_shot",
      "timeoutSeconds": 60,
      "requireConfirmation": true,
      "description": "List directory contents. Returns one entry per line: path\ttype\tsize.",
      "permissions": [
        "filesystem"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "recursive": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": "integer",
            "default": 500
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "id": "files.read",
      "permissions": [
        "filesystem"
      ],
      "requireConfirmation": true,
      "description": "Read a file's contents as text. Max 1 MB (10 MB hard cap).",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "maxBytes": {
            "type": "integer",
            "default": 1048576
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "id": "files.write",
      "description": "Write content to a file. Creates parent dirs.",
      "requireConfirmation": true,
      "confirmationReason": "Writing to files can be sensitive. Please confirm that you want to write to a file.",
      "precondition": {
        "type": "pathInRoots",
        "field": "path",
        "allowedRootsRef": "metadata.allowedRoots"
      },
      "permissions": [
        "filesystem"
      ],
      "confirmationPreview": {
        "fields": [
          "command"
        ],
        "maxChars": 500
      },
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "append": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    {
      "id": "files.stat",
      "permissions": [
        "filesystem"
      ],
      "description": "Get file metadata (size, modified time, is_dir, is_file).",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "id": "files.delete",
      "permissions": [
        "filesystem"
      ],
      "description": "Delete a file or directory. Use recursive=true for non-empty dirs.",
      "requireConfirmation": true,
      "confirmationReason": "Deleting files can be sensitive. Please confirm that you want to delete this file or directory.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "recursive": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "id": "files.copy",
      "permissions": [
        "filesystem"
      ],
      "taskType": "one_shot",
      "timeoutSeconds": 120,
      "description": "Copy a file or directory. Creates destination dirs.",
      "requireConfirmation": true,
      "confirmationReason": "Copying files can be sensitive. Please confirm that you want to copy this file or directory.",
      "parameters": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "destination"
        ]
      }
    },
    {
      "id": "files.move",
      "permissions": [
        "filesystem"
      ],
      "taskType": "one_shot",
      "timeoutSeconds": 120,
      "description": "Move/rename a file or directory.",
      "requireConfirmation": true,
      "confirmationReason": "Moving or renaming files can be sensitive. Please confirm that you want to move or rename this file or directory.",
      "parameters": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "destination"
        ]
      }
    }
  ],
  "changelog": {
    "summary": "You choose which folders the plugin may use (and which it must never touch).",
    "features": [
      "Plugin settings: allowed folders, denied folders and a read-only switch, per device",
      "Settings can be chosen when installing and changed later, on the device or remotely"
    ],
    "fixes": [],
    "breaking": []
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "allowedPaths": {
        "type": "array",
        "title": "Folders PAI may use",
        "description": "PAI can list, read and (unless read-only) change files only inside these folders.",
        "items": {
          "type": "string"
        },
        "default": [
          "~/Documents",
          "~/Downloads",
          "~/Pictures",
          "~/Videos",
          "~/Desktop",
          "/tmp/pai",
          "/data/pai"
        ],
        "maxItems": 50,
        "x-pai": {
          "widget": "paths",
          "suggestions": [
            {
              "label": "Documents",
              "path": "~/Documents"
            },
            {
              "label": "Downloads",
              "path": "~/Downloads"
            },
            {
              "label": "Pictures",
              "path": "~/Pictures"
            },
            {
              "label": "Videos",
              "path": "~/Videos"
            },
            {
              "label": "Music",
              "path": "~/Music"
            },
            {
              "label": "Desktop",
              "path": "~/Desktop"
            },
            {
              "label": "Home folder",
              "path": "~"
            }
          ]
        }
      },
      "deniedPaths": {
        "type": "array",
        "title": "Folders PAI must never touch",
        "description": "Always off limits, even inside an allowed folder.",
        "items": {
          "type": "string"
        },
        "default": [
          "~/.ssh",
          "~/.gnupg",
          "~/.config",
          "~/.local/share/keyrings"
        ],
        "maxItems": 50,
        "x-pai": {
          "widget": "paths"
        }
      },
      "readOnly": {
        "type": "boolean",
        "title": "Read-only",
        "description": "PAI may look at and read files but not write, copy, move or delete them.",
        "default": false
      }
    }
  }
}
