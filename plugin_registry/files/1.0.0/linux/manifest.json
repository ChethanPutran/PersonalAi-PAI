{
  "schemaVersion": 1,
  "id": "files",
  "name": "Files",
  "version": "1.0.0",
  "description": "Read, write, and manage files within allowed roots.",
  "author": "PAI",
  "license": "MIT",

  "runtime": {
    "kind": "native",
    "nativeModule": "pai.files",
    "minPaiVersion": "0.4.0"
  },

  "platforms": {
    "linux": {
      "artifact": "linux/libpai_files.so",
      "entrypoint": "pai_plugin_module_create"
    }
  },

  "architectures": ["x86_64"],
  "device_types": ["desktop"],
  "permissions": ["filesystem"],

  "metadata": {
    "allowed_roots": [
      "~/Documents", "~/Downloads", "~/Pictures", "~/Videos",
      "/tmp/pai", "/data/pai"
    ]
  },

  "capabilities": [
    {
      "id": "files.list",
      "description": "List directory contents. Returns one entry per line: path\ttype\tsize.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "recursive": {"type": "boolean", "default": false},
          "limit": {"type": "integer", "default": 500}
        },
        "required": ["path"]
      }
    },
    {
      "id": "files.read",
      "description": "Read a file's contents as text. Max 1 MB (10 MB hard cap).",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "max_bytes": {"type": "integer", "default": 1048576}
        },
        "required": ["path"]
      }
    },
    {
      "id": "files.write",
      "description": "Write content to a file. Creates parent dirs.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "content": {"type": "string"},
          "append": {"type": "boolean", "default": false}
        },
        "required": ["path", "content"]
      }
    },
    {
      "id": "files.stat",
      "description": "Get file metadata (size, modified time, is_dir, is_file).",
      "parameters": {
        "type": "object",
        "properties": {"path": {"type": "string"}},
        "required": ["path"]
      }
    },
    {
      "id": "files.delete",
      "description": "Delete a file or directory. Use recursive=true for non-empty dirs.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "recursive": {"type": "boolean", "default": false}
        },
        "required": ["path"]
      }
    },
    {
      "id": "files.copy",
      "description": "Copy a file or directory. Creates destination dirs.",
      "parameters": {
        "type": "object",
        "properties": {
          "source": {"type": "string"},
          "destination": {"type": "string"}
        },
        "required": ["source", "destination"]
      }
    },
    {
      "id": "files.move",
      "description": "Move/rename a file or directory.",
      "parameters": {
        "type": "object",
        "properties": {
          "source": {"type": "string"},
          "destination": {"type": "string"}
        },
        "required": ["source", "destination"]
      }
    }
  ]
}